    end
    subgraph PI["«device» EcoRefill · Raspberry Pi 5"]
        KIOSK["«artifact» Local React Kiosk<br/>Machine screen / QR display"]
        subgraph PYTHON["«execution environment» Python / Flask"]
            BACKEND["«artifact» machine_flow.py + YOLO<br/>Rewards · refills · alerts"]
        end
    end
    subgraph HARDWARE["«device» Machine Hardware"]
        SENSORS["«artifact» Camera · Scale<br/>Buttons · Sensors"]
        OUTPUTS["«artifact» Sorting Servos · Pump<br/>Machine Screen"]
    end
