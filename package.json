{
  "name": "ecorefill-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:kiosk": "vite build --mode kiosk",
    "lint": "eslint .",
    "test": "node --test tests/owner-*.test.mjs tests/monthly-recycling.test.mjs tests/phone-notifications.test.mjs src/firebase/*.test.mjs src/pages/auth/*.test.mjs src/pages/*/utils/*.test.mjs",
    "test:dashboard": "node --test tests/owner-*.test.mjs",
    "test:notifications": "node --test tests/phone-notifications.test.mjs && python3 ecorefill-pi/run_tests.py test_push_notifications.py",
    "test:pi": "python3 ecorefill-pi/run_tests.py",
    "test:rules": "firebase emulators:exec --project demo-ecorefill-rules --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "firebase": "^12.14.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.12"
  }
}
